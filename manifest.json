{
  "manifest_version": 3,
  "name": "X Follower Tracker",
  "version": "1.3.0",
  "description": "フォロワーページから新規・解除を取得。ローカル保存。APIなし。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Follower Tracker"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*/followers*",
        "https://x.com/*/verified_followers*",
        "https://x.com/*/following*",
        "https://twitter.com/*/followers*",
        "https://twitter.com/*/verified_followers*",
        "https://twitter.com/*/following*"
      ],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
