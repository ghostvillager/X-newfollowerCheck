{
  "manifest_version": 3,
  "name": "X Follower Tracker (Large Scale)",
  "version": "2.0.0",
  "description": "数万人規模のフォロワーを内部APIで取得・差分管理。DOMスクロール不要。",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Follower Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
